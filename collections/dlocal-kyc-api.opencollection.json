{
  "opencollection": "1.0.0",
  "info": {
    "name": "dLocal Payins Accounts KYC API",
    "version": "2.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "KYC",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get KYC Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dlocal.com/accounts/:account_id/kyc",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the current KYC verification status for a sub-account."
        },
        {
          "info": {
            "name": "Submit KYC Information",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dlocal.com/accounts/:account_id/kyc",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit Know Your Customer (KYC) documentation for a sub-account."
        }
      ]
    }
  ],
  "bundled": true
}