{
  "opencollection": "1.0.0",
  "info": {
    "name": "dLocal Payins Accounts Tokens API",
    "version": "2.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a Card Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dlocal.com/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Tokenize card data for future payments without storing raw card details."
        }
      ]
    }
  ],
  "bundled": true
}