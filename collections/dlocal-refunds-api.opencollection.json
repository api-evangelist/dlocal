{
  "opencollection": "1.0.0",
  "info": {
    "name": "dLocal Payins Accounts Refunds API",
    "version": "2.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Refunds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a Refund",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dlocal.com/refunds",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Reverse a card payment or initiate a bank transfer for alternative payment methods.\n"
        },
        {
          "info": {
            "name": "Retrieve a Refund",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dlocal.com/refunds/:refund_id",
            "params": [
              {
                "name": "refund_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch details of a specific refund transaction."
        }
      ]
    }
  ],
  "bundled": true
}